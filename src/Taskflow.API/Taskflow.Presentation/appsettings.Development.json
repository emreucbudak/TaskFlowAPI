{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "DefaultConnection": "Host=localhost;Port=5432;Database=TaskFlowDb;Username=__FROM_SECRET__;Password=__FROM_SECRET__"
  },
  "JWTSecretKey": {
    "SecretKey": "__FROM_SECRET__",
    "Issuer": "TaskflowAPI",
    "Audience": "TaskflowClient",
    "ExpiryInMinutes": 60,
    "RefreshTokenExpiryInDays": 7
  },
  "Stripe": {
    "SuccessUrl": "http://localhost:5173/checkout?status=success",
    "CancelUrl": "http://localhost:5173/checkout?status=cancel"
  }
}
